@@ -0,0 +1,46 @@
+//! OTools 宿主文件桥（wasm）：把 engine 同步的 `read`/`write` 接到 `window.figcraftOtools`。
+//!
+//! 本文件是 `crates/engine/src/cmd/file.rs` 里 `pub mod host_io;`（仅 wasm32 声明）的对应模块体。
+//! 由 `shell/patches/figcraft-hostio.patch` 一并落入上游；上线后由 `file.rs` 的
+//! `host_io::cache_get` / `host_io::write` 调用。
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+
+use base64::Engine as _;
+use wasm_bindgen::prelude::*;
+use wasm_bindgen_futures::JsFuture;
+use js_sys;
+
+thread_local! {
+    /// 宿主读到的文件字节，按路径缓存，供同步 `read` 命中。
+    static OPENED: RefCell<HashMap<String, Vec<u8>>> = RefCell::new(HashMap::new());
+}
+
+#[wasm_bindgen]
+extern "C" {
+    #[wasm_bindgen(js_namespace = figcraftOtools, js_name = "available")]
+    fn host_available() -> bool;
+    #[wasm_bindgen(js_namespace = figcraftOtools, js_name = "writeHostFile")]
+    fn host_write_file(path: &str, data_base64: &str) -> js_sys::Promise;
+}
+
+/// 宿主读到文件后由插件外壳调用：缓存字节，让随后的 `file.open` 同步 `read` 命中。
+pub fn cache_opened(path: &str, bytes: Vec<u8>) {
+    OPENED.with(|m| m.borrow_mut().insert(path.to_string(), bytes));
+}
+
+pub fn cache_get(path: &str) -> Option<Vec<u8>> {
+    OPENED.with(|m| m.borrow().get(path).cloned())
+}
+
+pub fn write(path: &str, bytes: Vec<u8>) {
+    if !host_available() {
+        return;
+    }
+    let data_base64 = base64::engine::general_purpose::STANDARD.encode(&bytes);
+    let path = path.to_string();
+    wasm_bindgen_futures::spawn_local(async move {
+        let _ = JsFuture::from(host_write_file(&path, &data_base64)).await;
+    });
+}
